/// Time Intelligence
table Comparison
	lineageTag: 63e70515-9f24-4051-9363-37252a69abaa

	calculationGroup

		calculationItem 'Current Period' =
				
				VAR StartDate = [Current Period Start Date]
				VAR EndDate = [Current Period End Date]
				
				RETURN
				CALCULATE (
				    SELECTEDMEASURE(),
				    REMOVEFILTERS ( dim_date ),
				    DATESBETWEEN (dim_date[full_date], StartDate, EndDate)
				)

		calculationItem 'Previous Period' =
				
				VAR StartDate = [Previous Period Start Date]
				VAR EndDate = [Previous Period End Date]
				
				RETURN
				CALCULATE (
				    SELECTEDMEASURE(),
				    REMOVEFILTERS ( dim_date ),
				    DATESBETWEEN (dim_date[full_date], StartDate, EndDate)
				)

		calculationItem Variance =
				
				CALCULATE (
				    SELECTEDMEASURE(),
				    'Comparison'[Calculation group column] = "Current Period"
				)
				-
				CALCULATE (
				    SELECTEDMEASURE(),
				    'Comparison'[Calculation group column] = "Previous Period"
				)

		calculationItem 'Variance %' =
				
				VAR CurrentValue =
				    CALCULATE (
				        SELECTEDMEASURE(),
				        REMOVEFILTERS ( dim_date ),
				        DATESBETWEEN (
				            dim_date[full_date],
				            [Current Period Start Date],
				            [Current Period End Date]
				        )
				    )
				
				VAR PreviousValue =
				    CALCULATE (
				        SELECTEDMEASURE(),
				        REMOVEFILTERS ( dim_date ),
				        DATESBETWEEN (
				            dim_date[full_date],
				            [Previous Period Start Date],
				            [Previous Period End Date]
				        )
				    )
				
				RETURN
				DIVIDE (
				    CurrentValue - PreviousValue, PreviousValue)

			formatStringDefinition = "0.0%;-0.0%;0.0%"

	column 'Calculation group column'
		dataType: string
		lineageTag: 9a1af329-b726-4ed5-a7bb-41d4aced25de
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: aaf7ae41-2ef4-4765-9e12-66eb32e3cc22
		isDefaultLabel
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

