	measure 'Scenario Summary' = ```
			
			VAR PriceChange = [Selected Price Change %]
			VAR CostChange = [Selected Cost Change %]
			VAR VolumeChange = [Selected Volume Change %]
			VAR Elasticity = [Selected Elasticity]
			VAR _Gap = REPT(UNICHAR(160), 3)
			
			RETURN
			     "🛈    " &
			    "Price : " & FORMAT(PriceChange, "+0%;-0%;0%") & _Gap 
			        & "   |   Cost : "  & FORMAT(CostChange, "+0%;-0%;0%") & _Gap 
			        & "   |   Volume : " & FORMAT(VolumeChange, "+0%;-0%;0%") & _Gap 
			        & "   |   Elasticity : "  & FORMAT(Elasticity, "0.0")
