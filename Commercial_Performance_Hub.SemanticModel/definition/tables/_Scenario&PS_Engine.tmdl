			    "Current Profit", [Trading Profit Current],
			    "Price Impact",   [Profit Bridge - Price Impact],
			    "Volume Impact",  [Profit Bridge - Volume Impact],
			    "Cost Impact",    [Profit Bridge - Cost Impact],
			    "Interaction",    [Profit Bridge - Interaction],
			
			    BLANK()
			)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: 9a33c845-74b6-474e-b4f3-9fe0bd9e03bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Impact Rank - Top (Product)' =
			
			RANKX(
			    ALLSELECTED(dim_products[product_name]),
