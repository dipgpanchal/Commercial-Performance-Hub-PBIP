		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Bridge - Volume Impact' =
			
			IF(ABS([Trading Profit Current] * [Scenario Volume Change %]) < 0.01,0,([Trading Profit Current] * [Scenario Volume Change %]))
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: 6915c453-0b24-4d09-9a58-1b28253f47c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Bridge - Cost Impact' =
			
			- [Cost Current] * [Selected Cost Change %]
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: d0b6ec5a-b13c-4c6d-b3dd-82f5a9b74757

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Bridge - Interaction' =
			
			VAR ExplainedImpact =
			      [Profit Bridge - Price Impact]
			    + [Profit Bridge - Volume Impact]
			    + [Profit Bridge - Cost Impact]
			
			VAR TotalProfitImpact =
			    [Scenario Profit] - [Trading Profit Current]
			
			RETURN
			    IF(ABS(TotalProfitImpact - ExplainedImpact) < 0.01,0,(TotalProfitImpact - ExplainedImpact) )
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: 72c59e92-89d8-4cd4-999b-3da2f006e25e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Bridge Value' =
			
