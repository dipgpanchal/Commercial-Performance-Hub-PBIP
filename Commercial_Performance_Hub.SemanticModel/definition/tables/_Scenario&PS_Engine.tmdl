		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Scenario Rating' =
			
			VAR RevenueThreshold = 0
			VAR ProfitThreshold = 0
			VAR DemandThreshold = -0.05
			
			VAR Revenue = [Revenue Impact %]
			VAR Profit = [Profit Impact %]
			VAR Demand = [Elasticity Volume Change %]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    // Strong Opportunity
			    Revenue > RevenueThreshold && Profit > ProfitThreshold && Demand >= DemandThreshold, "Strong Opportunity",
			
			    // Mixed Outcome
			    Revenue > RevenueThreshold && Profit > ProfitThreshold && Demand < DemandThreshold, "Mixed Outcome",
			
			    Revenue > RevenueThreshold && Profit <= ProfitThreshold, "Mixed Outcome",
			
			    // Margin-led Strategy
			    Revenue <= RevenueThreshold && Profit > ProfitThreshold, "Margin-led Strategy",
			
			    // High Risk
			    Revenue < RevenueThreshold && Profit < ProfitThreshold,  "High Risk",
			
			    // Default
			    "Minimal Impact"
			)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: 81f1f72a-16e9-4e88-8a38-162fd2c66c7b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Commercial Insight' = ```
			
			
			VAR Price = [Selected Price Change %]
			VAR Elasticity = [Selected Elasticity]
			
			VAR Demand = [Elasticity Volume Change %]
			VAR Revenue = [Revenue Impact %]
			VAR Profit = [Profit Impact %]
			
			VAR Rating = [Scenario Rating]
			
			/*-----------------------------------------
			Scenario Description
			-----------------------------------------*/
			
			VAR ScenarioText =
			SWITCH(
			    TRUE(),
			
			    Price > 0, "A " &   FORMAT(Price,"0%") & " price increase with an elasticity of " &  FORMAT(Elasticity,"0.0"),
			    Price < 0, "A " &   FORMAT(ABS(Price),"0%") &  " price reduction with an elasticity of " &  FORMAT(Elasticity,"0.0"),
			    "No price change with an elasticity of " & FORMAT(Elasticity,"0.0"))
			
			/*-----------------------------------------
			Demand Impact
			-----------------------------------------*/
			
			VAR DemandText =
			SWITCH(
			    TRUE(),
			
			    Demand > 0, "is expected to increase demand by approximately " &  FORMAT(Demand,"0.0%") & ".",
			    Demand < 0,  "is expected to reduce demand by approximately " &  FORMAT(ABS(Demand),"0.0%") & ".",
			    "is expected to have no material impact on demand.")
			
			/*-----------------------------------------
			Revenue Impact
			-----------------------------------------*/
			
			VAR RevenueText =
			SWITCH(
			    TRUE(),
			
			    Revenue > 0, "Revenue is projected to increase by " & FORMAT(Revenue,"0.0%") & ".",
			    Revenue < 0,  "Revenue is projected to decrease by " & FORMAT(ABS(Revenue),"0.0%") & ".",
			    "Revenue is expected to remain stable.")
			
			/*-----------------------------------------
			Profit Impact
			-----------------------------------------*/
			
			VAR ProfitText =
			SWITCH(
			    TRUE(),
			
			    Profit > 0, "Profit is expected to improve by " & FORMAT(Profit,"0.0%") & ".",
			    Profit < 0, "Profit is expected to decline by " & FORMAT(ABS(Profit),"0.0%") & ".",
			    "Profit is expected to remain stable.")
			
			/*-----------------------------------------
			Commercial Recommendation
			-----------------------------------------*/
			
			VAR Recommendation =
			SWITCH(
			    Rating,
			
			    "Strong Opportunity",  "🟢 Strong Opportunity - Higher revenue and profit with limited demand risk.",
			    "Mixed Outcome",  "🟡 Mixed Outcome - Financial gains are offset by weaker demand or profitability.",
			    "Margin-led Strategy", "🟡 Margin-led Strategy - Lower sales are accepted to improve margins.",
			    "High Risk", "🔴 High Risk - Revenue and profit are both expected to decline.",
			    "⚪ Minimal Impact - Current assumptions produce little commercial change."
			)
			
			RETURN
			Recommendation & " " & UNICHAR(10) & UNICHAR(10) & ScenarioText & UNICHAR(10) & DemandText & UNICHAR(10) & RevenueText & UNICHAR(10) & ProfitText
			
			
			```
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: d4c58f40-2f7b-4d04-918b-a0ad2f85b61b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sensitivity Units' =
			
			VAR PriceChange =
			    DIVIDE(
			        SELECTEDVALUE(
			            Price_Change_pct[Price Change %]
			        ),
			        100
			    )
			
			VAR Elasticity =
			    [Selected Elasticity]
			
			VAR BaseUnits =
			    [Units Sold Current]
			
			RETURN
			    BaseUnits *
			    (
			        1 +
			        PriceChange * Elasticity
			    )
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 72cca7c2-c0a5-4c6e-8c2e-c12a8b1980df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Sensitivity Units' =
			
			VAR PriceChange =
			    [Selected Price Change %]
			
			VAR Elasticity =
			    [Selected Elasticity]
			
			VAR BaseUnits =
			    [Units Sold Current]
			
			RETURN
			    BaseUnits *
			    (
			        1 +
			        PriceChange * Elasticity
			    )
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 3f245c9d-d51a-4b1b-a6bb-75ad6107e3a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Sensitivity Point' =
			
			VAR AxisPrice =
			    DIVIDE(
			        SELECTEDVALUE(
			            Price_Change_pct[Price Change %]
			        ),
			        100
			    )
			
			VAR SelectedPrice =
			    [Selected Price Change %]
			
			RETURN
			    IF(
			        AxisPrice = SelectedPrice,
			        [Sensitivity Units],
			        BLANK()
			    )
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 6bc1615e-af56-49c3-94cb-bee7287a44df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sensitivity Units %' =
			
			VAR PriceChange =
			    DIVIDE(
			        SELECTEDVALUE('Price Sensitivity Axis'[Value], 0),
			        100
			    )
			
			VAR Elasticity =
			    SELECTEDVALUE(
			        'Sensitivity Elasticity'[Elasticity],
			        0
			    )
			
			RETURN
			    PriceChange * Elasticity
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 003a4eba-1038-4a16-bcd5-8c9483e331b8

		formatStringDefinition = "0%;-0%;0%"

	measure 'Selected Sensitivity Units %' =
			
			VAR PriceChange =
			    DIVIDE(
			        SELECTEDVALUE(
			            'Price Sensitivity Axis'[Value],
			            0
			        ),
			        100
			    )
			
			VAR SelectedElasticity =
			    [Selected Elasticity]
			
			RETURN
			    PriceChange * SelectedElasticity
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: a3011585-f484-4a8e-a06c-fb0ceaea7bf2

		formatStringDefinition = "0%;-0%;0%"

	measure 'Selected Elasticity & Price Change Label' =
			
			"Selected Elasticity : " & FORMAT([Selected Elasticity], "0.0;-0.0") & " | " & "Selected Price Change : " & FORMAT([Selected Price Change %], "0.0%;-0.0%")
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: 80ef3b1d-b912-4e43-b2e8-37335f485324

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Outcome Current Units' =
			
			[Units Sold Current]
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: fe812efe-0310-47f6-95c0-7e440ec02311

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Outcome Scenario Units' =
			
			VAR PriceChange =
			    [Selected Price Change %]
			
			VAR BaseVolumeChange =
			    [Selected Volume Change %]
			
			VAR RowElasticity =
			    SELECTEDVALUE(
			        'Sensitivity Elasticity'[Elasticity],
			        0
			    )
			
			VAR ElasticityVolumeChange =
			    PriceChange * RowElasticity
			
			VAR NetVolumeChange =
			    BaseVolumeChange + ElasticityVolumeChange
			
			RETURN
			    [Units Sold Current] * (1 + NetVolumeChange)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: c5a70d57-3267-4e01-bb87-8a5007d6d7e9

		formatStringDefinition = "#,##0;-#.##0"

	measure 'Outcome Units Change %' =
			
			DIVIDE(
			    [Outcome Scenario Units] - [Outcome Current Units],
			    [Outcome Current Units]
			)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: c220da89-c696-4e00-a1e6-47f4ffe93bc3

		formatStringDefinition = "0.0%;-0.0%;0.0%"

	measure 'Outcome Scenario Revenue' =
			
			VAR PriceChange =
			    [Selected Price Change %]
			
			VAR BaseVolumeChange =
			    [Selected Volume Change %]
			
			VAR RowElasticity =
			    SELECTEDVALUE(
			        'Sensitivity Elasticity'[Elasticity],
			        0
			    )
			
			VAR NetVolumeChange =
			    BaseVolumeChange
			        + (PriceChange * RowElasticity)
			
			VAR ScenarioUnits =
			    [Units Sold Current] * (1 + NetVolumeChange)
			
			VAR CurrentUnitRevenue =
			    DIVIDE(
			        [Revenue Current],
			        [Units Sold Current]
			    )
			
			RETURN
			    ScenarioUnits
			        * CurrentUnitRevenue
			        * (1 + PriceChange)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: eb00905a-81af-4be9-bb97-c132743412f9

		formatStringDefinition = "$#,##0;($#,##0)"

	measure 'Outcome Scenario Profit' =
			
			[Outcome Scenario Revenue]
			    - [Outcome Scenario Cost]
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 5e5ddb9b-f443-49b6-b775-fd27f4f488f2

		formatStringDefinition = "$#,##0;($#,##0)"

	measure 'Outcome Scenario Cost' =
			
			VAR BaseCost =
			    [Cost Current]
			
			VAR BaseVolumeChange =
			    [Selected Volume Change %]
			
			VAR PriceChange =
			    [Selected Price Change %]
			
			VAR RowElasticity =
			    SELECTEDVALUE(
			        'Sensitivity Elasticity'[Elasticity],
			        0
			    )
			
			VAR NetVolumeChange =
			    BaseVolumeChange
			        + (PriceChange * RowElasticity)
			
			VAR CostChange =
			    [Selected Cost Change %]
			
			RETURN
			    BaseCost
			        * (1 + NetVolumeChange)
			        * (1 + CostChange)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 2ed83b49-cbb6-4008-8fbc-e635d7799520

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Outcome Profit vs Current %' =
			
			DIVIDE(
			    [Outcome Scenario Profit] - [Trading Profit Current],
			    [Trading Profit Current],
			    0
			)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: d6838bdf-df4f-4556-aa7d-cd4965f94cd9

		formatStringDefinition = "0.0%;-0.0%;0.0%"

	measure 'Current Product Price' =
			
			SELECTEDVALUE(
			    dim_products[product_price]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 37fb55ee-7a79-4909-8f76-3c766693914a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Scenario Product Price' =
			
			VAR CurrentPrice =
			    [Current Product Price]
			
			VAR PriceChange =
			    [Selected Price Change %]
			
			RETURN
			   CurrentPrice * (1 + PriceChange)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 72f529fb-76c7-4e8c-b216-fb1ec4f4317f

		formatStringDefinition = "\$#,0.00;(\$#,0.00);\$#,0.00"

	measure 'Current Product Margin %' =
			
			DIVIDE(
			    [Trading Profit Current],
			    [Revenue Current],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: f6595ae1-36b1-4bae-b10b-fb158fe15482

	measure 'Product Profit Impact $' =
			
			[Outcome Scenario Profit]
			    - [Trading Profit Current]
		formatString: \$#,0;(\$#,0);\$#,0
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 1d3d5c7c-910f-4297-a2fb-bbc6fa366352

	measure 'Product Profit Impact $ Icon' =
			
			IF(
			    ISINSCOPE(dim_products[product_name]),
			    [Product Profit Impact $],
			    BLANK()
			)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Price Sensitivity
		lineageTag: 2eccf928-99fb-44df-be7d-24bef79df0dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 71f3e5cc-3dcb-4314-893d-fb6444dcf357
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Scenario&PS_Engine = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = e4920e46deb8495ab4044c4d4de53187

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

