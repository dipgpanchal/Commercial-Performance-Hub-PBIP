	measure 'Scenario Cost' =
			
			VAR BaseCost =   [Cost Current]
			VAR VolumeChange = [Scenario Volume Change %]
			VAR CostChange = [Selected Cost Change %]
			
			RETURN
			    BaseCost * (1 + VolumeChange) * (1 + CostChange)
		formatString: \$#,0;(\$#,0);\$#,0
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: add57fd8-4077-4cc7-98cd-477589ed846f

	measure 'Scenario Margin %' =
			
			DIVIDE(
			    [Scenario Profit],
			    [Scenario Revenue]
