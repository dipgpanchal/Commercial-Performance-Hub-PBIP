	measure 'Profit Impact Rank - Bottom (Product)' =
			
			RANKX(
			    ALLSELECTED(dim_products[product_name]),
			    [Profit Impact $],
			    ,
			    ASC,
			    DENSE
			)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: 80785cc9-1ce8-4eb3-9c2a-e898ed659c6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Impact Top Bottom Flag' =
			
			VAR Impact = [Profit Impact $]
			VAR TopRank = [Profit Impact Rank - Top (Product)]
			VAR BottomRank = [Profit Impact Rank - Bottom (Product)]
			
			RETURN
			IF(
			    NOT ISBLANK(Impact)
			        &&
			        ABS(Impact) >= 0.01
			        &&
			        (
			            TopRank <= 3
			            || BottomRank <= 3
			        ),
			    1,
			    0
			)
		isHidden
		displayFolder: 11 Scenario & Sensitivity\Scenario Planner
		lineageTag: f0ceee1f-bfd0-4d05-bdf3-ab0613e3b5b2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

