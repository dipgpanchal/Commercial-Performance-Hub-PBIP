	measure 'Trading Margin Variance' =
			
			(
			    CALCULATE(
			        [Trading Margin %],
			        'Comparison'[Calculation group column] = "Current Period"
			    )
			    -
			    CALCULATE(
			        [Trading Margin %],
			        'Comparison'[Calculation group column] = "Previous Period"
			    )
			) * 100
		isHidden
		displayFolder: 04 KPI Comparison
		lineageTag: 70cadaf1-b4cc-43d1-a308-1a63013bb3e1

		formatStringDefinition = "0.0 pp;-0.0 pp;0.0 pp"

